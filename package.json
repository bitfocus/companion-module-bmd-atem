{
	"name": "bmd-atem",
	"version": "4.5.0-2",
	"homepage": "https://github.com/bitfocus/companion-module-atem#readme",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"dev": "run build:main --watch",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw .",
		"dist": "yarn companion-module-build",
		"test": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-bmd-atem.git"
	},
	"license": "MIT",
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"run prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"run lint:raw --fix"
		]
	},
	"engines": {
		"node": ">=26"
	},
	"dependencies": {
		"@atem-connection/camera-control": "^0.4.0",
		"@atem-connection/image-tools": "^2.0.0",
		"@companion-module/base": "~2.1.3",
		"@julusian/image-rs": "^2.5.0",
		"atem-connection": "3.11.0",
		"lodash-es": "^4.18.1",
		"type-fest": "^5.10.0"
	},
	"devDependencies": {
		"@companion-module/tools": "patch:@companion-module/tools@npm%3A3.1.0#~/.yarn/patches/@companion-module-tools-npm-3.1.0-bab0f4d1d7.patch",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"packageManager": "yarn@4.18.1"
}
